generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  role                Role                 @default(USER)
  phoneNumber         String?
  password            String?
  accounts            Account[]
  emergencyRequests   EmergencyRequest[]
  safetyConfirmations SafetyConfirmation[]
  sessions            Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Alert {
  id           String       @id @default(cuid())
  title        String
  message      String
  disasterType DisasterType
  createdAt    DateTime     @default(now())
}

model SafetyGuide {
  id           String       @id @default(cuid())
  disasterType DisasterType @unique
  content      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model EmergencyRequest {
  id          String          @id @default(cuid())
  userId      String
  phoneNumber String
  latitude    Float
  longitude   Float
  createdAt   DateTime        @default(now())
  status      EmergencyStatus @default(OPEN)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SafetyConfirmation {
  id          String   @id @default(cuid())
  userId      String
  phoneNumber String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  VOLUNTEER
  AUTHORITY
}

enum DisasterType {
  FLOOD
  EARTHQUAKE
  FIRE
}

enum EmergencyStatus {
  OPEN
  RESOLVED
}
