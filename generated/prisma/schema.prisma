generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String?              @unique
  emailVerified        DateTime?
  image                String?
  role                 Role                 @default(USER)
  phoneNumber          String?
  password             String?
  // User location for emergency services
  latitude             Float?
  longitude            Float?
  address              String?
  // Profile completion tracking
  profileCompleted     Boolean              @default(false)
  accounts             Account[]
  emergencyRequests    EmergencyRequest[]
  safetyConfirmations  SafetyConfirmation[]
  sessions             Session[]
  // Rescue requests created by user
  rescueRequests       RescueRequest[]      @relation("UserRescueRequests")
  // Rescue requests assigned to volunteer
  volunteerAssignments RescueRequest[]      @relation("VolunteerAssignments")
  // Volunteer profile for location tracking
  volunteerProfile     VolunteerProfile?
  // Safe zones created by this user
  createdSafeZones     SafeZone[]
  // Resource nodes created by this user
  createdResourceNodes ResourceNode[]
  // Messaging system
  sentMessages         Message[]            @relation("SentMessages")
  receivedMessages     Message[]            @relation("ReceivedMessages")
  // Community groups
  ownedGroups          CommunityGroup[]     @relation("GroupOwner")
  groupMemberships     GroupMembership[]
  communityPosts       CommunityPost[]
  // Training progress
  trainingProgress     TrainingProgress[]
  // AI/ML features
  riskAssessments      RiskAssessment[]
  // Real-time communication
  realtimeMessages     RealtimeMessage[]
  channelAccess        ChannelAccess[]
  channelMemberships   ChannelMembership[]
  emergencyBroadcasts  EmergencyBroadcast[]
  // Direct messaging
  directConversations1 DirectConversation[] @relation("Participant1")
  directConversations2 DirectConversation[] @relation("Participant2")
  directMessages       DirectMessage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Alert {
  id           String       @id @default(cuid())
  title        String
  message      String
  disasterType DisasterType
  latitude     Float        @default(15.3173)
  longitude    Float        @default(75.7139)
  radiusKm     Int          @default(5)
  createdAt    DateTime     @default(now())

  @@index([latitude, longitude])
}

model SafetyGuide {
  id           String       @id @default(cuid())
  disasterType DisasterType @unique
  content      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model EmergencyRequest {
  id          String          @id @default(cuid())
  userId      String
  phoneNumber String
  latitude    Float
  longitude   Float
  createdAt   DateTime        @default(now())
  status      EmergencyStatus @default(OPEN)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SafetyConfirmation {
  id          String   @id @default(cuid())
  userId      String
  phoneNumber String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  VOLUNTEER
  AUTHORITY
}

enum DisasterType {
  FLOOD
  EARTHQUAKE
  FIRE
  MEDICAL
  BUILDING_COLLAPSE
  OTHER
}

enum EmergencyStatus {
  OPEN
  RESOLVED
}

// Rescue request status for SOS system
enum RescueStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  NO_VOLUNTEER
}

// Safe zone types for shelters
enum SafeZoneType {
  SHELTER
  CAMP
  HOSPITAL
}

// Risk levels for danger zones
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// Resource types for disaster response
enum ResourceType {
  BOAT
  GENERATOR
  WATER
  FOOD
  MEDICAL
  OTHER
}

// Creator types for resources
enum CreatorType {
  VOLUNTEER
  BUSINESS
  AUTHORITY
}

// Message types for in-app messaging
enum MessageType {
  TEXT
  LOCATION
  RESOURCE_SHARE
  EMERGENCY_UPDATE
  SYSTEM
}

// Message status
enum MessageStatus {
  SENT
  DELIVERED
  READ
}

// Training module status
enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

// Training module difficulty
enum TrainingDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Community group types
enum CommunityGroupType {
  NEIGHBORHOOD
  DISASTER_RESPONSE
  TRAINING
  GENERAL
}

// Rescue requests (SOS) from users in danger
model RescueRequest {
  id               String        @id @default(cuid())
  userId           String?
  user             User?         @relation("UserRescueRequests", fields: [userId], references: [id])
  volunteerId      String?
  volunteer        User?         @relation("VolunteerAssignments", fields: [volunteerId], references: [id])
  status           RescueStatus  @default(PENDING)
  message          String?
  location         String?
  latitude         Float?
  longitude        Float?
  disasterType     DisasterType? // Optional post-SOS detail
  note             String? // Optional post-SOS note
  searchRadiusUsed Float? // km radius that found the volunteer (2, 5, or 10)
  // ML-assisted ETA prediction fields
  etaMinMinutes    Int? // Minimum estimated arrival time
  etaMaxMinutes    Int? // Maximum estimated arrival time
  etaConfidence    String? // HIGH, MEDIUM, LOW
  etaFactors       String? // JSON array of factors affecting ETA
  escalatedAt      DateTime?
  assignedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([volunteerId])
}

// Volunteer profile with live location tracking
model VolunteerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float?
  longitude Float?
  available Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// Safe zones (shelters, camps, hospitals) created by volunteers or authorities
model SafeZone {
  id        String       @id @default(cuid())
  name      String
  type      SafeZoneType
  latitude  Float
  longitude Float
  capacity  Int?
  createdBy String // User ID who created this zone
  creator   User         @relation(fields: [createdBy], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([latitude, longitude])
}

// Resource nodes for disaster response (crowdsourced resources)
model ResourceNode {
  id           String       @id @default(cuid())
  name         String
  resourceType ResourceType
  quantity     Int
  latitude     Float
  longitude    Float
  createdBy    CreatorType
  contactInfo  String?
  userId       String // User ID who created this resource
  creator      User         @relation(fields: [userId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([latitude, longitude])
  @@index([resourceType])
}

// In-app messaging system
model Message {
  id          String        @id @default(cuid())
  senderId    String
  receiverId  String
  content     String
  messageType MessageType   @default(TEXT)
  status      MessageStatus @default(SENT)
  metadata    String? // JSON for location, resource info, etc.
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  sender      User          @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User          @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// Community groups for neighborhood watch, disaster response teams, etc.
model CommunityGroup {
  id          String             @id @default(cuid())
  name        String
  description String?
  type        CommunityGroupType
  latitude    Float? // Optional location for location-based groups
  longitude   Float?
  radiusKm    Float? // For neighborhood groups
  ownerId     String
  isPublic    Boolean            @default(true)
  maxMembers  Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  owner       User               @relation("GroupOwner", fields: [ownerId], references: [id])
  members     GroupMembership[]
  posts       CommunityPost[]

  @@index([type])
  @@index([latitude, longitude])
}

model GroupMembership {
  id       String         @id @default(cuid())
  userId   String
  groupId  String
  role     String         @default("MEMBER") // MEMBER, MODERATOR, ADMIN
  joinedAt DateTime       @default(now())
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
}

model CommunityPost {
  id        String         @id @default(cuid())
  groupId   String
  authorId  String
  title     String?
  content   String
  postType  String         @default("TEXT") // TEXT, ALERT, RESOURCE, EVENT
  metadata  String? // JSON for additional data
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  group     CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([createdAt])
}

// Training modules for volunteers and community members
model TrainingModule {
  id          String             @id @default(cuid())
  title       String
  description String
  content     String // Rich text content
  difficulty  TrainingDifficulty
  duration    Int // Minutes
  category    String // "First Aid", "Disaster Response", etc.
  isRequired  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  progress    TrainingProgress[]

  @@index([category])
  @@index([difficulty])
}

model TrainingProgress {
  id          String         @id @default(cuid())
  userId      String
  moduleId    String
  status      TrainingStatus @default(NOT_STARTED)
  progress    Int            @default(0) // Percentage 0-100
  score       Int? // Quiz score if applicable
  startedAt   DateTime?
  completedAt DateTime?
  expiresAt   DateTime? // For certifications that expire
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  module      TrainingModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([status])
}

// AI/ML Risk Assessment for predictive analytics
model RiskAssessment {
  id              String       @id @default(cuid())
  userId          String
  latitude        Float
  longitude       Float
  disasterType    DisasterType
  riskScore       Float // 0.0 to 1.0
  confidence      Float // 0.0 to 1.0
  factors         String // JSON array of risk factors
  recommendations String // JSON array of recommendations
  validUntil      DateTime
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([latitude, longitude])
  @@index([disasterType])
  @@index([validUntil])
}

// Real-time communication channels
model RealtimeChannel {
  id          String              @id @default(cuid())
  name        String
  type        RealtimeChannelType
  description String?
  isActive    Boolean             @default(true)
  priority    Int                 @default(1)
  isPublic    Boolean             @default(false) // Public channels vs private/role-based
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  messages    RealtimeMessage[]
  members     ChannelMembership[]

  @@index([type])
  @@index([isActive])
}

// Channel membership for access control
model ChannelMembership {
  id        String          @id @default(cuid())
  channelId String
  userId    String
  role      Role
  canRead   Boolean         @default(true)
  canWrite  Boolean         @default(true)
  joinedAt  DateTime        @default(now())
  channel   RealtimeChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

// Direct message conversations
model DirectConversation {
  id           String          @id @default(cuid())
  participant1 String // User ID
  participant2 String // Authority/Volunteer ID
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user1        User            @relation("Participant1", fields: [participant1], references: [id], onDelete: Cascade)
  user2        User            @relation("Participant2", fields: [participant2], references: [id], onDelete: Cascade)
  messages     DirectMessage[]

  @@unique([participant1, participant2])
  @@index([participant1])
  @@index([participant2])
}

// Direct messages between users
model DirectMessage {
  id             String              @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  messageType    RealtimeMessageType @default(TEXT)
  priority       MessagePriority     @default(NORMAL)
  location       String? // JSON for lat/lng
  metadata       String? // JSON for additional data
  isRead         Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  conversation   DirectConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isRead])
}

// Real-time messages for emergency communication
model RealtimeMessage {
  id              String              @id @default(cuid())
  channelId       String
  senderId        String
  content         String
  messageType     RealtimeMessageType @default(TEXT)
  priority        MessagePriority     @default(NORMAL)
  location        String? // JSON for lat/lng
  metadata        String? // JSON for additional data
  isSystemMessage Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  channel         RealtimeChannel     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender          User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([senderId])
  @@index([createdAt])
  @@index([priority])
}

// Channel access control (legacy - keeping for compatibility)
model ChannelAccess {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  role      Role
  canRead   Boolean  @default(true)
  canWrite  Boolean  @default(true)
  joinedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

// Emergency broadcasts for authorities
model EmergencyBroadcast {
  id           String          @id @default(cuid())
  title        String
  message      String
  priority     MessagePriority
  senderId     String
  affectedArea String? // JSON for lat/lng/radius
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  expiresAt    DateTime?
  sender       User            @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([priority])
  @@index([isActive])
  @@index([createdAt])
}

// Advanced mapping features - Points of Interest
model PointOfInterest {
  id          String   @id @default(cuid())
  name        String
  category    String // "Hospital", "Police", "Fire Station", "Shelter", etc.
  latitude    Float
  longitude   Float
  address     String?
  phoneNumber String?
  capacity    Int?
  isActive    Boolean  @default(true)
  metadata    String? // JSON for additional info
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([latitude, longitude])
  @@index([isActive])
}

// Message priority levels
enum MessagePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// Real-time channel types
enum RealtimeChannelType {
  EMERGENCY
  AUTHORITY
  VOLUNTEER
  COMMAND
  GENERAL
}

// Real-time message types
enum RealtimeMessageType {
  TEXT
  LOCATION
  ALERT
  STATUS
  BROADCAST
}

// Route optimization and danger zone avoidance
model DangerZone {
  id          String    @id @default(cuid())
  name        String
  description String?
  latitude    Float
  longitude   Float
  radiusKm    Float
  riskLevel   RiskLevel
  isActive    Boolean   @default(true)
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([latitude, longitude])
  @@index([isActive])
  @@index([validUntil])
}
