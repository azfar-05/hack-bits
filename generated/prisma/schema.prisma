generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                   String               @id @default(cuid())
  name                 String?
  email                String?              @unique
  emailVerified        DateTime?
  image                String?
  role                 Role                 @default(USER)
  phoneNumber          String?
  password             String?
  // User location for emergency services
  latitude             Float?
  longitude            Float?
  address              String?
  // Profile completion tracking
  profileCompleted     Boolean              @default(false)
  accounts             Account[]
  emergencyRequests    EmergencyRequest[]
  safetyConfirmations  SafetyConfirmation[]
  sessions             Session[]
  // Rescue requests created by user
  rescueRequests       RescueRequest[]      @relation("UserRescueRequests")
  // Rescue requests assigned to volunteer
  volunteerAssignments RescueRequest[]      @relation("VolunteerAssignments")
  // Volunteer profile for location tracking
  volunteerProfile     VolunteerProfile?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Alert {
  id           String       @id @default(cuid())
  title        String
  message      String
  disasterType DisasterType
  createdAt    DateTime     @default(now())
}

model SafetyGuide {
  id           String       @id @default(cuid())
  disasterType DisasterType @unique
  content      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model EmergencyRequest {
  id          String          @id @default(cuid())
  userId      String
  phoneNumber String
  latitude    Float
  longitude   Float
  createdAt   DateTime        @default(now())
  status      EmergencyStatus @default(OPEN)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SafetyConfirmation {
  id          String   @id @default(cuid())
  userId      String
  phoneNumber String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  VOLUNTEER
  AUTHORITY
}

enum DisasterType {
  FLOOD
  EARTHQUAKE
  FIRE
  MEDICAL
  BUILDING_COLLAPSE
  OTHER
}

enum EmergencyStatus {
  OPEN
  RESOLVED
}

// Rescue request status for SOS system
enum RescueStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  NO_VOLUNTEER
}

// Rescue requests (SOS) from users in danger
model RescueRequest {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("UserRescueRequests", fields: [userId], references: [id])
  volunteerId      String?
  volunteer        User?         @relation("VolunteerAssignments", fields: [volunteerId], references: [id])
  status           RescueStatus  @default(PENDING)
  message          String?
  location         String?
  latitude         Float?
  longitude        Float?
  disasterType     DisasterType? // Optional post-SOS detail
  note             String? // Optional post-SOS note
  searchRadiusUsed Float? // km radius that found the volunteer (2, 5, or 10)
  escalatedAt      DateTime?
  assignedAt       DateTime?
  completedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([volunteerId])
}

// Volunteer profile with live location tracking
model VolunteerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float?
  longitude Float?
  available Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
